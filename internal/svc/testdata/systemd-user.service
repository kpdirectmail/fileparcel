[Unit]
Description=FileParcel file sharing server
Documentation=file:///home/alice/fileparcel/docs/FILEPARCEL.md
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
NotifyAccess=main
ExecStart="/home/alice/fileparcel/bin/fileparcel" serve --home "/home/alice/fileparcel"
Restart=always
RestartSec=2
TimeoutStopSec=40
WatchdogSec=60
UMask=0077
NoNewPrivileges=yes
LimitNOFILE=65536
[Install]
WantedBy=default.target
