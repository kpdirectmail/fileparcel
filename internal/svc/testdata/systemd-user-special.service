[Unit]
Description=FileParcel file sharing server
Documentation=file:///home/a%%20b/100%%25$x%%22q/docs/FILEPARCEL.md
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
NotifyAccess=main
ExecStart="/home/a b/100%%$$x\"q/bin/fileparcel" serve --home "/home/a b/100%%$$x\"q"
Restart=always
RestartSec=2
TimeoutStopSec=40
WatchdogSec=60
UMask=0077
NoNewPrivileges=yes
LimitNOFILE=65536
[Install]
WantedBy=default.target
