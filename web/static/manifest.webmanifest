{
  "id": "/",
  "name": "FileParcel",
  "short_name": "FileParcel",
  "description": "Self-hosted, encrypted file sharing for your home and team.",
  "lang": "en",
  "dir": "auto",
  "start_url": "/files",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fbf9f5",
  "theme_color": "#2b7ad6",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "__FP_ASSET_BASE__/icons/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "__FP_ASSET_BASE__/icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "__FP_ASSET_BASE__/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "__FP_ASSET_BASE__/icons/app-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Upload files",
      "short_name": "Upload",
      "url": "/files?upload=1",
      "icons": [{ "src": "__FP_ASSET_BASE__/icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Shared with me",
      "short_name": "Shared",
      "url": "/shared",
      "icons": [{ "src": "__FP_ASSET_BASE__/icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  }
}
